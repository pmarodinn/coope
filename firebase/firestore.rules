rules_version = '2';

// Gerado por `npm run regras` a partir de src/lib/pesquisa-registro.ts. Não edite à mão.
//
// Quem abre a pesquisa só consegue CRIAR um registro com exatamente os 75 campos
// abaixo, cada um do tipo certo (texto ou decimal). Não consegue ler, alterar nem
// apagar: nome e celular só saem pelo console do Firebase ou pela exportação.
//
// O Firestore recusa regra que gaste mais de 1.000 expressões por pedido, então
// aqui só o contato e os dados do envio têm formato conferido. Os valores das
// respostas são conferidos na exportação, pelo selo do código.
service cloud.firestore {
  match /databases/{database}/documents {
    match /respostas/{id} {
      allow create: if id.matches('^[0-9]{8}T[0-9]{4}-[0-9a-z]{6}$') && registroValido(request.resource.data);
      allow read, update, delete: if false;
    }

    // Tamanho exato e nomes só desta lista: nenhum campo a mais, nenhum a menos.
    function registroValido(d) {
      return d.size() == 75
        && d.keys().hasOnly(['contato_nome', 'contato_celular', 'contato_aceite', 'envio_em', 'envio_versao', 'envio_codigo', 'p01_uf_mt', 'p01_uf_ms', 'p01_uf_go', 'p01_uf_pr', 'p01_uf_rs', 'p01_uf_sp', 'p01_uf_mg', 'p01_uf_ba', 'p01_uf_sc', 'p01_uf_to', 'p01_uf_ma', 'p01_uf_pi', 'p01_uf_pa', 'p01_uf_ro', 'p01_uf_outro', 'p01_uf_txt', 'p02_culturas_soja', 'p02_culturas_milho', 'p02_culturas_algodao', 'p02_culturas_cafe', 'p02_culturas_cana', 'p02_culturas_trigo_arroz_feijao', 'p02_culturas_pecuaria', 'p02_culturas_leite', 'p02_culturas_outras', 'p02_culturas_outras_txt', 'p02_culturas_txt', 'p03_area', 'p03_area_txt', 'p04_faturamento', 'p04_faturamento_txt', 'p05_formato', 'p05_formato_txt', 'p06_controle', 'p06_controle_txt', 'p07_contador', 'p07_contador_txt', 'p08_imposto', 'p08_imposto_txt', 'p09_multas', 'p09_multas_txt', 'p10_custeio_proprio', 'p10_custeio_banco', 'p10_custeio_cooperativa', 'p10_custeio_revenda', 'p10_custeio_fundo_cpr', 'p10_custeio_outro', 'p10_custeio_txt', 'p11_prazo', 'p11_prazo_txt', 'p12_taxa', 'p12_taxa_txt', 'p13_negado', 'p13_negado_txt', 'p14_obstaculos_juros', 'p14_obstaculos_demora', 'p14_obstaculos_garantia', 'p14_obstaculos_documentacao', 'p14_obstaculos_limite', 'p14_obstaculos_nada', 'p14_obstaculos_txt', 'p15_seguro', 'p15_seguro_txt', 'p16_expansao', 'p16_expansao_txt', 'p17_tecnologia', 'p17_tecnologia_txt', 'p18_certificado', 'p18_certificado_txt'])
        && grupo1(d)
        && grupo2(d)
        && grupo3(d)
        && grupo4(d)
        && grupo5(d)
        && grupo6(d)
        && grupo7(d)
        && grupo8(d);
    }

    function grupo1(d) {
      return d.contato_nome is string && d.contato_nome.size() >= 2 && d.contato_nome.size() <= 60
        && d.contato_celular is string && d.contato_celular.size() == 14 && d.contato_celular.matches('^\\+55[0-9]{11}$')
        && d.contato_aceite is string && d.contato_aceite.size() == 3 && d.contato_aceite.matches('^sim$')
        && d.envio_em is string && d.envio_em.size() == 20 && d.envio_em.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$')
        && d.envio_versao is float && d.envio_versao == 3
        && d.envio_codigo is string && d.envio_codigo.size() >= 10 && d.envio_codigo.size() <= 200 && d.envio_codigo.matches('^COOPE[0-9]-[0-9A-Z-]+$')
        && d.p01_uf_mt is float
        && d.p01_uf_ms is float
        && d.p01_uf_go is float
        && d.p01_uf_pr is float;
    }

    function grupo2(d) {
      return d.p01_uf_rs is float
        && d.p01_uf_sp is float
        && d.p01_uf_mg is float
        && d.p01_uf_ba is float
        && d.p01_uf_sc is float
        && d.p01_uf_to is float
        && d.p01_uf_ma is float
        && d.p01_uf_pi is float
        && d.p01_uf_pa is float
        && d.p01_uf_ro is float;
    }

    function grupo3(d) {
      return d.p01_uf_outro is float
        && d.p01_uf_txt is string
        && d.p02_culturas_soja is float
        && d.p02_culturas_milho is float
        && d.p02_culturas_algodao is float
        && d.p02_culturas_cafe is float
        && d.p02_culturas_cana is float
        && d.p02_culturas_trigo_arroz_feijao is float
        && d.p02_culturas_pecuaria is float
        && d.p02_culturas_leite is float;
    }

    function grupo4(d) {
      return d.p02_culturas_outras is float
        && d.p02_culturas_outras_txt is string && d.p02_culturas_outras_txt.size() >= 0 && d.p02_culturas_outras_txt.size() <= 24
        && d.p02_culturas_txt is string
        && d.p03_area is float
        && d.p03_area_txt is string
        && d.p04_faturamento is float
        && d.p04_faturamento_txt is string
        && d.p05_formato is float
        && d.p05_formato_txt is string
        && d.p06_controle is float;
    }

    function grupo5(d) {
      return d.p06_controle_txt is string
        && d.p07_contador is float
        && d.p07_contador_txt is string
        && d.p08_imposto is float
        && d.p08_imposto_txt is string
        && d.p09_multas is float
        && d.p09_multas_txt is string
        && d.p10_custeio_proprio is float
        && d.p10_custeio_banco is float
        && d.p10_custeio_cooperativa is float;
    }

    function grupo6(d) {
      return d.p10_custeio_revenda is float
        && d.p10_custeio_fundo_cpr is float
        && d.p10_custeio_outro is float
        && d.p10_custeio_txt is string
        && d.p11_prazo is float
        && d.p11_prazo_txt is string
        && d.p12_taxa is float
        && d.p12_taxa_txt is string
        && d.p13_negado is float
        && d.p13_negado_txt is string;
    }

    function grupo7(d) {
      return d.p14_obstaculos_juros is float
        && d.p14_obstaculos_demora is float
        && d.p14_obstaculos_garantia is float
        && d.p14_obstaculos_documentacao is float
        && d.p14_obstaculos_limite is float
        && d.p14_obstaculos_nada is float
        && d.p14_obstaculos_txt is string
        && d.p15_seguro is float
        && d.p15_seguro_txt is string
        && d.p16_expansao is float;
    }

    function grupo8(d) {
      return d.p16_expansao_txt is string
        && d.p17_tecnologia is float
        && d.p17_tecnologia_txt is string
        && d.p18_certificado is float
        && d.p18_certificado_txt is string;
    }

    // Pré-cadastro de escritórios (página /contadores), gerado de src/lib/contador-lead.ts.
    // Mesmo princípio: o site só cria, no formato exato; ninguém lê pela internet.
    match /contadores/{id} {
      allow create: if id.matches('^[0-9]{8}T[0-9]{4}-[0-9a-z]{6}$') && leadValido(request.resource.data);
      allow read, update, delete: if false;
    }

    function leadValido(d) {
      return d.size() == 32
        && d.keys().hasOnly(['contato_nome', 'contato_cargo', 'contato_celular', 'contato_email', 'contato_horario', 'escritorio_nome', 'escritorio_cnpj', 'escritorio_crc', 'escritorio_cidade', 'escritorio_uf', 'escritorio_equipe', 'carteira_produtores', 'carteira_contribuintes', 'carteira_atividades', 'carteira_lcdpr', 'rotina_software', 'rotina_software_outro', 'rotina_notas', 'rotina_extratos', 'reforma_preparo', 'reforma_dores', 'proximo_interesse', 'proximo_prazo', 'origem', 'observacao', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'aceite', 'envio_em', 'envio_versao'])
        && leadGrupo1(d)
        && leadGrupo2(d)
        && leadGrupo3(d)
        && leadGrupo4(d);
    }

    function leadGrupo1(d) {
      return d.contato_nome is string && d.contato_nome.size() >= 2 && d.contato_nome.size() <= 60
        && d.contato_cargo is string && d.contato_cargo in ['socio', 'contador', 'gerente', 'analista', 'outro']
        && d.contato_celular is string && d.contato_celular.size() == 14 && d.contato_celular.matches('^\\+55[0-9]{11}$')
        && d.contato_email is string && d.contato_email.size() >= 6 && d.contato_email.size() <= 120 && d.contato_email.matches('^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$')
        && d.contato_horario is string && d.contato_horario in ['manha', 'tarde', 'qualquer']
        && d.escritorio_nome is string && d.escritorio_nome.size() >= 2 && d.escritorio_nome.size() <= 100
        && d.escritorio_cnpj is string && d.escritorio_cnpj.size() >= 0 && d.escritorio_cnpj.size() <= 14 && d.escritorio_cnpj.matches('^([0-9]{14})?$')
        && d.escritorio_crc is string && d.escritorio_crc.size() >= 0 && d.escritorio_crc.size() <= 30;
    }

    function leadGrupo2(d) {
      return d.escritorio_cidade is string && d.escritorio_cidade.size() >= 2 && d.escritorio_cidade.size() <= 60
        && d.escritorio_uf is string && d.escritorio_uf in ['AC', 'AL', 'AM', 'AP', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 'MG', 'MS', 'MT', 'PA', 'PB', 'PE', 'PI', 'PR', 'RJ', 'RN', 'RO', 'RR', 'RS', 'SC', 'SE', 'SP', 'TO']
        && d.escritorio_equipe is string && d.escritorio_equipe in ['1', '2a5', '6a15', '16a40', 'mais40']
        && d.carteira_produtores is string && d.carteira_produtores in ['ate10', '11a30', '31a80', '81a200', 'mais200']
        && d.carteira_contribuintes is string && d.carteira_contribuintes in ['nenhum', '1a5', '6a15', '16a40', 'mais40', 'nao_sei']
        && d.carteira_atividades is string && d.carteira_atividades.size() <= 200 && d.carteira_atividades.matches('^(graos|algodao|cafe|cana|pecuaria|leite|hortifruti|outras)(;(graos|algodao|cafe|cana|pecuaria|leite|hortifruti|outras))*$')
        && d.carteira_lcdpr is string && d.carteira_lcdpr in ['todos', 'alguns', 'nenhum']
        && d.rotina_software is string && d.rotina_software in ['dominio', 'alterdata', 'questor', 'fortes', 'sci', 'contmatic', 'mastermaq', 'prosoft', 'nasajon', 'proprio', 'planilha', 'outro'];
    }

    function leadGrupo3(d) {
      return d.rotina_software_outro is string && d.rotina_software_outro.size() >= 0 && d.rotina_software_outro.size() <= 60
        && d.rotina_notas is string && d.rotina_notas in ['cliente_envia', 'sefaz_certificado', 'cnpj_escritorio', 'misto']
        && d.rotina_extratos is string && d.rotina_extratos in ['pdf', 'ofx', 'acesso_banco', 'nao_recebe']
        && d.reforma_preparo is string && d.reforma_preparo in ['comecou', 'planejando', 'nao_comecou', 'sem_saber']
        && d.reforma_dores is string && d.reforma_dores.size() <= 200 && d.reforma_dores.matches('^(volume|cnpj|notas|regime|extrato|cobranca|equipe|credito)(;(volume|cnpj|notas|regime|extrato|cobranca|equipe|credito))*$')
        && d.proximo_interesse is string && d.proximo_interesse in ['diagnostico', 'piloto', 'demonstracao', 'conteudo']
        && d.proximo_prazo is string && d.proximo_prazo in ['2026', 'tri1', 'depois', 'conhecendo']
        && d.origem is string && d.origem in ['instagram', 'indicacao', 'evento', 'whatsapp', 'google', 'outro'];
    }

    function leadGrupo4(d) {
      return d.observacao is string && d.observacao.size() >= 0 && d.observacao.size() <= 500
        && d.utm_source is string && d.utm_source.size() >= 0 && d.utm_source.size() <= 80 && d.utm_source.matches('^[A-Za-z0-9 _.:/+-]*$')
        && d.utm_medium is string && d.utm_medium.size() >= 0 && d.utm_medium.size() <= 80 && d.utm_medium.matches('^[A-Za-z0-9 _.:/+-]*$')
        && d.utm_campaign is string && d.utm_campaign.size() >= 0 && d.utm_campaign.size() <= 80 && d.utm_campaign.matches('^[A-Za-z0-9 _.:/+-]*$')
        && d.utm_content is string && d.utm_content.size() >= 0 && d.utm_content.size() <= 80 && d.utm_content.matches('^[A-Za-z0-9 _.:/+-]*$')
        && d.aceite is string && d.aceite in ['sim']
        && d.envio_em is string && d.envio_em.size() == 20 && d.envio_em.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$')
        && d.envio_versao is float && d.envio_versao == 1;
    }

    // Pesquisa com escritórios de contabilidade (/pesquisa-contadores), gerado de
    // src/lib/pesquisa-contadores.ts. O site só cria, no formato exato.
    match /pesquisa_contadores/{id} {
      allow create: if id.matches('^[0-9]{8}T[0-9]{4}-[0-9a-z]{6}$') && pcValido(request.resource.data);
      allow read, update, delete: if false;
    }

    function pcValido(d) {
      return d.size() == 25
        && d.keys().hasOnly(['contato_nome', 'contato_celular', 'contato_aceite', 'p01_uf', 'p02_equipe', 'p03_clientes', 'p04_areas', 'p05_produtores', 'p06_acima36', 'p07_tempo', 'p08_notas', 'p09_extratos', 'p10_sistema', 'p11_ferramentas', 'p12_gasto', 'p13_crescer', 'p14_como_crescer', 'p15_trava', 'p16_honorario_rural', 'p17_reforma_feito', 'p18_reforma_preocupa', 'utm_source', 'utm_content', 'envio_em', 'envio_versao'])
        && pcGrupo1(d)
        && pcGrupo2(d)
        && pcGrupo3(d)
        && pcGrupo4(d);
    }

    function pcGrupo1(d) {
      return d.contato_nome is string && d.contato_nome.size() >= 2 && d.contato_nome.size() <= 60
        && d.contato_celular is string && d.contato_celular.size() == 14 && d.contato_celular.matches('^\\+55[0-9]{11}$')
        && d.contato_aceite is string && d.contato_aceite in ['sim']
        && d.p01_uf is string && d.p01_uf in ['mt', 'ms', 'go', 'pr', 'rs', 'sp', 'mg', 'ba', 'sc', 'to', 'ma', 'pi', 'pa', 'ro', 'outro']
        && d.p02_equipe is string && d.p02_equipe in ['1', '2a5', '6a15', '16a40', 'mais40']
        && d.p03_clientes is string && d.p03_clientes in ['ate30', '31a100', '101a300', '301a800', 'mais800']
        && d.p04_areas is string && d.p04_areas.size() <= 300 && d.p04_areas.matches('^(produtor|empresa_agro|comercio|servicos|industria|construcao|pessoa_fisica|terceiro_setor|outros)(;(produtor|empresa_agro|comercio|servicos|industria|construcao|pessoa_fisica|terceiro_setor|outros))*$')
        && d.p05_produtores is string && d.p05_produtores in ['nenhum', 'ate10', '11a30', '31a100', 'mais100'];
    }

    function pcGrupo2(d) {
      return d.p06_acima36 is string && d.p06_acima36 in ['sem_produtor', 'nenhum', '1a5', '6a15', 'mais15', 'nao_sabe']
        && d.p07_tempo is string && d.p07_tempo.size() <= 300 && d.p07_tempo.matches('^(cobrar_docs|lancar_notas|conciliar|apurar|acessorias|folha|atender|retrabalho)(;(cobrar_docs|lancar_notas|conciliar|apurar|acessorias|folha|atender|retrabalho))*$')
        && d.p08_notas is string && d.p08_notas in ['cliente_manda', 'portal_sefaz', 'automatico', 'misto']
        && d.p09_extratos is string && d.p09_extratos in ['pdf_whats', 'ofx', 'acesso_banco', 'automatico', 'nao_mandam']
        && d.p10_sistema is string && d.p10_sistema in ['dominio', 'alterdata', 'questor', 'fortes', 'sci', 'contmatic', 'mastermaq', 'prosoft', 'nasajon', 'proprio', 'outro']
        && d.p11_ferramentas is string && d.p11_ferramentas.size() <= 300 && d.p11_ferramentas.matches('^(captura_notas|conciliacao|portal_cliente|atendimento|tarefas|rural|ia|planilhas|nenhuma)(;(captura_notas|conciliacao|portal_cliente|atendimento|tarefas|rural|ia|planilhas|nenhuma))*$')
        && d.p12_gasto is string && d.p12_gasto in ['ate500', '500a2000', '2a5mil', '5a15mil', 'mais15mil', 'nao_sabe']
        && d.p13_crescer is string && d.p13_crescer in ['bastante', 'pouco', 'manter', 'enxugar'];
    }

    function pcGrupo3(d) {
      return d.p14_como_crescer is string && d.p14_como_crescer.size() <= 300 && d.p14_como_crescer.matches('^(indicacao|parcerias|redes|google|eventos|novo_servico|aquisicao|nao_busca)(;(indicacao|parcerias|redes|google|eventos|novo_servico|aquisicao|nao_busca))*$')
        && d.p15_trava is string && d.p15_trava.size() <= 300 && d.p15_trava.matches('^(gente|rotina|preco|concorrencia|desorganizado|vender|nada)(;(gente|rotina|preco|concorrencia|desorganizado|vender|nada))*$')
        && d.p16_honorario_rural is string && d.p16_honorario_rural in ['sem_produtor', 'ate300', '300a800', '800a1500', '1500a3000', 'mais3000']
        && d.p17_reforma_feito is string && d.p17_reforma_feito.size() <= 300 && d.p17_reforma_feito.matches('^(curso|mapeou|conversou|emissor|cnpj|honorarios|nada)(;(curso|mapeou|conversou|emissor|cnpj|honorarios|nada))*$')
        && d.p18_reforma_preocupa is string && d.p18_reforma_preocupa.size() <= 300 && d.p18_reforma_preocupa.matches('^(volume|cobrar|notas_erradas|sistemas|regras|responsabilidade|tranquilo)(;(volume|cobrar|notas_erradas|sistemas|regras|responsabilidade|tranquilo))*$')
        && d.utm_source is string && d.utm_source.size() >= 0 && d.utm_source.size() <= 80 && d.utm_source.matches('^[A-Za-z0-9 _.:/+-]*$')
        && d.utm_content is string && d.utm_content.size() >= 0 && d.utm_content.size() <= 80 && d.utm_content.matches('^[A-Za-z0-9 _.:/+-]*$')
        && d.envio_em is string && d.envio_em.size() == 20 && d.envio_em.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$');
    }

    function pcGrupo4(d) {
      return d.envio_versao is float && d.envio_versao == 1;
    }
  }
}
